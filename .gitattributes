# 统一换行与文本属性
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.node binary
*.sqlite binary
*.db binary

# 锁文件：保留，不合并
# 文档/配置
*.md text
*.json text
*.toml text
*.yml text
*.yaml text
